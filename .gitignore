.venv
env/
venv/

# The sweep's incremental checkpoint, rewritten after every model. The finished
# cross_model_dsync.csv is committed on purpose: reproducing it means fetching
# about 13 GB of weights, and a reader checking a number in the paper should not
# have to.
experiments/cross_model_dsync.json
experiments/sweep.log

